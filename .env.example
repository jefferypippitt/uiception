# Used only to build the "Open in v0"
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_URL=

# Chrome Origin Trial token(s) for html-in-canvas
# Register per-origin (free): https://developer.chrome.com/origintrials
NEXT_PUBLIC_HTML_IN_CANVAS_OT_TOKEN=

# Clerk powers the LIVE waitlist inside the landing-page-v1 template preview.
# is fine for working on UI. Grab both from https://dashboard.clerk.com/~/api-keys
# (a free dev instance), then Clerk Dashboard → Waitlist → enable waitlist.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Svix signing secret from the webhook endpoint in Clerk Dashboard. Only needed
# if you're exercising the waitlist webhook locally:
# clerk webhooks listen --forward-to http://localhost:3000/api/webhooks
CLERK_WEBHOOK_SIGNING_SECRET=

# Where Clerk sends people after accepting an invite / signing in. Default: /
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
