{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "partners-section-v4",
  "title": "Partners Section v4",
  "description": "Static partners section: centered heading and description above a single row of eight square icon tiles (AWS, Cloudflare, DigitalOcean, Docker, Kubernetes, GitLab, Pulumi, Grafana).",
  "dependencies": [],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/new-york/blocks/partners-section-v4/page.tsx",
      "content": "import PartnersSectionV4 from \"./components/partners-section-v4\"\n\nexport default function Page() {\n  return <PartnersSectionV4 />\n}\n",
      "type": "registry:page",
      "target": "app/partners-section-v4/page.tsx"
    },
    {
      "path": "registry/new-york/blocks/partners-section-v4/components/partners-section-v4.tsx",
      "content": "import PartnerTile from \"./partner-tile\"\nimport { partnersSectionV4Content } from \"../lib/config\"\nimport { partners } from \"../lib/partners\"\n\nexport default function PartnersSectionV4() {\n  const { heading, description } = partnersSectionV4Content\n\n  return (\n    <section className=\"py-16 md:py-24\">\n      <div className=\"mx-auto max-w-6xl px-4\">\n        <div className=\"mx-auto flex max-w-2xl flex-col items-center gap-5 text-center\">\n          <h2 className=\"text-3xl leading-[1.05] font-medium tracking-[-0.035em] text-balance text-foreground sm:text-4xl lg:text-5xl\">\n            {heading}\n          </h2>\n          <p className=\"max-w-xl text-base leading-relaxed text-pretty text-muted-foreground md:text-lg\">\n            {description}\n          </p>\n        </div>\n\n        <ul\n          aria-label=\"Partner companies\"\n          className=\"mx-auto mt-14 grid max-w-5xl grid-cols-8 gap-2 py-2 sm:gap-3 sm:py-4 md:mt-20 md:gap-4 lg:py-6\"\n        >\n          {partners.map((partner) => (\n            <PartnerTile key={partner.name} partner={partner} />\n          ))}\n        </ul>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/partners-section-v4/components/partners-section-v4.tsx"
    },
    {
      "path": "registry/new-york/blocks/partners-section-v4/components/partner-tile.tsx",
      "content": "import PartnerIcon from \"./partner-icon\"\nimport type { Partner } from \"../lib/partners\"\n\nexport default function PartnerTile({ partner }: { partner: Partner }) {\n  return (\n    <li className=\"flex items-center justify-center odd:-translate-y-2 even:translate-y-2 sm:odd:-translate-y-4 sm:even:translate-y-4 lg:odd:-translate-y-6 lg:even:translate-y-6\">\n      <PartnerIcon partner={partner} className=\"size-7 sm:size-10 lg:size-14\" />\n      <span className=\"sr-only\">{partner.name}</span>\n    </li>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/partners-section-v4/components/partner-tile.tsx"
    },
    {
      "path": "registry/new-york/blocks/partners-section-v4/components/partner-icon.tsx",
      "content": "import { cn } from \"@/lib/utils\"\n\nimport type { Partner } from \"../lib/partners\"\n\nexport default function PartnerIcon({\n  partner,\n  className,\n}: {\n  partner: Partner\n  className?: string\n}) {\n  const Light = partner.light\n  const Dark = partner.dark\n  const shellClass = cn(\"inline-flex items-center justify-center\", className)\n\n  if (Dark) {\n    return (\n      <span className={shellClass}>\n        <Light className=\"block h-full w-full dark:hidden\" aria-hidden />\n        <Dark className=\"hidden h-full w-full dark:block\" aria-hidden />\n      </span>\n    )\n  }\n\n  return (\n    <span className={shellClass}>\n      <Light className=\"h-full w-full\" aria-hidden />\n    </span>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/partners-section-v4/components/partner-icon.tsx"
    },
    {
      "path": "registry/new-york/blocks/partners-section-v4/lib/config.ts",
      "content": "export const partnersSectionV4Content = {\n  heading: \"The companies that keep Acme running\",\n  description:\n    \"Acme runs on tools from these partners. They help keep the app online and your data backed up.\",\n} as const\n",
      "type": "registry:lib",
      "target": "app/partners-section-v4/lib/config.ts"
    },
    {
      "path": "registry/new-york/blocks/partners-section-v4/lib/partners.ts",
      "content": "import type { ComponentType, SVGProps } from \"react\"\n\nimport { AwsLight } from \"@/components/ui/svgs/awsLight\"\nimport { AwsDark } from \"@/components/ui/svgs/awsDark\"\nimport { Cloudflare } from \"@/components/ui/svgs/cloudflare\"\nimport { Digitalocean } from \"@/components/ui/svgs/digitalocean\"\nimport { Docker } from \"@/components/ui/svgs/docker\"\nimport { Kubernetes } from \"@/components/ui/svgs/kubernetes\"\nimport { Gitlab } from \"@/components/ui/svgs/gitlab\"\nimport { Pulumi } from \"@/components/ui/svgs/pulumi\"\nimport { Grafana } from \"@/components/ui/svgs/grafana\"\n\nexport type SvgComponent = ComponentType<SVGProps<SVGSVGElement>>\n\nexport type Partner = {\n  name: string\n  light: SvgComponent\n  dark?: SvgComponent\n}\n\nexport const partners: Partner[] = [\n  { name: \"AWS\",          light: AwsLight, dark: AwsDark },\n  { name: \"Cloudflare\",   light: Cloudflare },\n  { name: \"DigitalOcean\", light: Digitalocean },\n  { name: \"Docker\",       light: Docker },\n  { name: \"Kubernetes\",   light: Kubernetes },\n  { name: \"GitLab\",       light: Gitlab },\n  { name: \"Pulumi\",       light: Pulumi },\n  { name: \"Grafana\",      light: Grafana },\n]\n",
      "type": "registry:lib",
      "target": "app/partners-section-v4/lib/partners.ts"
    },
