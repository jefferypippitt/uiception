{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "brands-section-v10",
  "title": "Brands Section v10",
  "description": "Stacked brands section with a title, a wrapping color logo strip, and a muted closer.",
  "dependencies": [
    "geist@^1.7.0"
  ],
