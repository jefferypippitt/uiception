{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "footer-section-v1",
  "title": "Footer Section v1",
  "description": "Muted rounded footer with brand copy, four link columns, and a bottom row with Instagram and TikTok links.",
