{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "brands-section-v1",
  "title": "Brands Section v1",
  "description": "Compact brands strip with a trust label and an infinite marquee of AI brand logos with light/dark mode support (Nvidia, OpenAI, Grok, Perplexity AI, Claude AI, Gemini).",
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/new-york/blocks/brands-section-v1/page.tsx",
      "content": "import BrandsSectionV1 from \"./brands-section-v1\"\n\nexport default function Page() {\n  return <BrandsSectionV1 />\n}\n",
      "type": "registry:page",
      "target": "app/brands-section-v1/page.tsx"
    },
    {
      "path": "registry/new-york/blocks/brands-section-v1/brands-section-v1.tsx",
      "content": "import Marquee from \"./marquee\"\nimport { brands } from \"./brands\"\n\nimport \"./brands-section-v1.css\"\n\nexport default function BrandsSectionV1() {\n  return (\n    <section className=\"py-10 md:py-14\">\n      <div className=\"mx-auto max-w-6xl px-4\">\n        <div className=\"grid items-center gap-8 md:grid-cols-[minmax(0,260px)_minmax(0,1fr)] md:gap-10 lg:gap-14\">\n          <p className=\"max-w-[16rem] text-base leading-snug font-medium text-muted-foreground md:text-lg\">\n            Trusted by the best leading brands:\n          </p>\n          <Marquee brands={brands} />\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/brands-section-v1/brands-section-v1.tsx"
    },
    {
      "path": "registry/new-york/blocks/brands-section-v1/marquee.tsx",
      "content": "import type { Brand } from \"./brands\"\nimport BrandLogo from \"./brand-logo\"\n\nexport default function Marquee({ brands }: { brands: Brand[] }) {\n  return (\n    <div className=\"relative min-w-0 overflow-hidden\">\n      <div\n        className=\"pointer-events-none absolute top-0 left-0 z-1 h-full w-16 bg-linear-to-r from-background to-transparent motion-reduce:hidden\"\n        aria-hidden\n      />\n      <div\n        className=\"pointer-events-none absolute top-0 right-0 z-1 h-full w-16 bg-linear-to-l from-background to-transparent motion-reduce:hidden\"\n        aria-hidden\n      />\n\n      <div className=\"bs1-track flex w-max flex-nowrap items-center py-1.4 will-change-transform backface-hidden\">\n        <div\n          className=\"flex shrink-0 items-center gap-10 px-2 md:gap-15 md:px-3 lg:gap-16\"\n          role=\"list\"\n          aria-label=\"Brand logos\"\n        >\n          {brands.map((brand) => (\n            <div\n              key={brand.name}\n              role=\"listitem\"\n              className=\"flex shrink-0 items-center justify-center px-4 md:px-6\"\n            >\n              <BrandLogo brand={brand} />\n            </div>\n          ))}\n        </div>\n        <div\n          className=\"flex shrink-0 items-center gap-10 px-2 md:gap-15 md:px-3 lg:gap-16\"\n          aria-hidden\n        >\n          {brands.map((brand) => (\n            <div\n              key={`dup-${brand.name}`}\n              className=\"flex shrink-0 items-center justify-center px-4 md:px-6\"\n            >\n              <BrandLogo brand={brand} />\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/brands-section-v1/marquee.tsx"
    },
    {
      "path": "registry/new-york/blocks/brands-section-v1/brand-logo.tsx",
      "content": "import { cn } from \"@/lib/utils\"\n\nimport type { Brand } from \"./brands\"\n\nconst brandLogoShellClass =\n  \"inline-flex h-7 w-32 max-w-full items-center justify-center md:h-8 md:w-36\"\n\nexport default function BrandLogo({\n  brand,\n  className,\n}: {\n  brand: Brand\n  className?: string\n}) {\n  const Light = brand.light\n  const Dark = brand.dark\n  const shellClass = cn(brandLogoShellClass, className)\n\n  if (Dark) {\n    return (\n      <span className={shellClass}>\n        <Light\n          className=\"block h-full w-full dark:hidden\"\n          aria-label={brand.name}\n        />\n        <Dark\n          className=\"hidden h-full w-full dark:block\"\n          aria-label={brand.name}\n        />\n      </span>\n    )\n  }\n\n  return (\n    <span className={shellClass}>\n      <Light className=\"h-full w-full\" aria-label={brand.name} />\n    </span>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/brands-section-v1/brand-logo.tsx"
    },
    {
      "path": "registry/new-york/blocks/brands-section-v1/brands.ts",
      "content": "import type { ComponentType, SVGProps } from \"react\"\n\nimport { NvidiaWordmarkLight } from \"@/components/ui/svgs/nvidiaWordmarkLight\"\nimport { NvidiaWordmarkDark } from \"@/components/ui/svgs/nvidiaWordmarkDark\"\nimport { OpenaiWordmarkLight } from \"@/components/ui/svgs/openaiWordmarkLight\"\nimport { OpenaiWordmarkDark } from \"@/components/ui/svgs/openaiWordmarkDark\"\nimport { GrokWordmarkLight } from \"@/components/ui/svgs/grokWordmarkLight\"\nimport { GrokWordmarkDark } from \"@/components/ui/svgs/grokWordmarkDark\"\nimport { PerplexityWordmarkLight } from \"@/components/ui/svgs/perplexityWordmarkLight\"\nimport { PerplexityWordmarkDark } from \"@/components/ui/svgs/perplexityWordmarkDark\"\nimport { ClaudeAiWordmarkIconLight } from \"@/components/ui/svgs/claudeAiWordmarkIconLight\"\nimport { ClaudeAiWordmarkIconDark } from \"@/components/ui/svgs/claudeAiWordmarkIconDark\"\nimport { GoogleWordmark } from \"@/components/ui/svgs/googleWordmark\"\n\nexport type SvgComponent = ComponentType<SVGProps<SVGSVGElement>>\n\nexport type Brand = {\n  name: string\n  light: SvgComponent\n  dark?: SvgComponent\n}\n\nexport const brands: Brand[] = [\n  { name: \"Nvidia\",        light: NvidiaWordmarkLight,       dark: NvidiaWordmarkDark },\n  { name: \"OpenAI\",        light: OpenaiWordmarkLight,       dark: OpenaiWordmarkDark },\n  { name: \"Grok\",          light: GrokWordmarkLight,         dark: GrokWordmarkDark },\n  { name: \"Perplexity AI\", light: PerplexityWordmarkLight,   dark: PerplexityWordmarkDark },\n  { name: \"Claude AI\",     light: ClaudeAiWordmarkIconLight, dark: ClaudeAiWordmarkIconDark },\n  { name: \"Google\",        light: GoogleWordmark },\n]\n",
      "type": "registry:file",
      "target": "app/brands-section-v1/brands.ts"
    },
    {
      "path": "registry/new-york/blocks/brands-section-v1/brands-section-v1.css",
      "content": ".bs1-track {\n  animation: bs1-marquee 28s linear infinite;\n}\n\n@keyframes bs1-marquee {\n  from {\n    transform: translate3d(0, 0, 0);\n  }\n  to {\n    transform: translate3d(-50%, 0, 0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .bs1-track {\n    animation-duration: 0.01ms;\n    animation-iteration-count: 1;\n  }\n}\n",
      "type": "registry:file",
      "target": "app/brands-section-v1/brands-section-v1.css"
    },
