    {
      "path": "registry/new-york/blocks/hero-section-v1/hero-section-v1.tsx",
      "content": "import { GeistPixelCircle } from \"geist/font/pixel\"\r\nimport { Button } from \"@/components/ui/button\"\r\nimport { blockImageUrl } from \"@/lib/block-image-url\"\r\nimport { ArrowUpRightIcon } from \"lucide-react\"\r\n\r\nimport BrandsSectionV1 from \"./components/brands-section-v1\"\r\nimport MacOsTerminal from \"./components/mac-os-terminal\"\r\n\r\nexport default function HeroSectionV1() {\r\n  return (\r\n    <>\r\n      <section className=\"pt-16 md:pt-20 lg:pt-24\">\r\n        <div className=\"mx-auto max-w-6xl px-4\">\r\n          <div className=\"grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-12\">\r\n            <h1 className=\"text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl xl:text-7xl\">\r\n              Agents built{\" \"}\r\n              <span className={`${GeistPixelCircle.className} font-normal tracking-normal`}>\r\n                for coding\r\n              </span>\r\n            </h1>\r\n\r\n            <div className=\"flex flex-col gap-6\">\r\n              <p className=\"text-lg leading-relaxed text-muted-foreground sm:text-xl\">\r\n                Build and deploy AI coding agents with a single SDK. Get composable tools, intelligent model routing, and deep codebase context that works across any repository.\r\n              </p>\r\n              <div className=\"flex flex-col gap-3 sm:flex-row sm:flex-wrap\">\r\n                <Button variant=\"default\" size=\"lg\">\r\n                  Start building\r\n                  <ArrowUpRightIcon data-icon=\"inline-end\" />\r\n                </Button>\r\n                <Button variant=\"outline\" size=\"lg\">\r\n                  View docs\r\n                  <ArrowUpRightIcon data-icon=\"inline-end\" />\r\n                </Button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <BrandsSectionV1 />\r\n\r\n      <section className=\"px-4 pb-16 md:pb-20 lg:pb-24\">\r\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-2xl px-4 py-10 md:px-8 md:py-14\">\r\n          {/* eslint-disable-next-line @next/next/no-img-element */}\r\n          <img\r\n            src={blockImageUrl(\r\n              \"https://uiception.com/images/blocks/hero-section-v1/hero-section-v1-bg.png\",\r\n              \"/images/blocks/hero-section-v1/hero-section-v1-bg.png\",\r\n            )}\r\n            alt=\"\"\r\n            className=\"pointer-events-none object-cover object-center absolute inset-0 w-full h-full\"\r\n            aria-hidden={true}\r\n          />\r\n          <div className=\"relative mx-auto max-w-2xl\">\r\n            <MacOsTerminal />\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </>\r\n  )\r\n}\r\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/hero-section-v1.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/brands-section-v1.tsx",
      "content": "import type { Brand } from \"../lib/brands\"\nimport { brands } from \"../lib/brands\"\nimport BrandLogo from \"./brand-logo\"\n\nimport \"../styles/brands-section-v1.css\"\n\nfunction Marquee({ brands: list }: { brands: Brand[] }) {\n  return (\n    <div className=\"bs1-marquee-wrap min-w-0\">\n      <div className=\"bs1-fade bs1-fade-left\" aria-hidden />\n      <div className=\"bs1-fade bs1-fade-right\" aria-hidden />\n\n      <div className=\"bs1-track\">\n        <div className=\"bs1-set\" role=\"list\" aria-label=\"Brand logos\">\n          {list.map((brand) => (\n            <div key={brand.name} role=\"listitem\" className=\"bs1-slot flex shrink-0 items-center justify-center\">\n              <BrandLogo brand={brand} />\n            </div>\n          ))}\n        </div>\n        <div className=\"bs1-set\" aria-hidden>\n          {list.map((brand) => (\n            <div key={`dup-${brand.name}`} className=\"bs1-slot flex shrink-0 items-center justify-center\">\n              <BrandLogo brand={brand} />\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default function BrandsSectionV1() {\n  return (\n    <section className=\"py-10 md:py-14\">\n      <div className=\"mx-auto max-w-6xl px-4\">\n        <div className=\"grid items-center gap-8 md:grid-cols-[minmax(0,260px)_minmax(0,1fr)] md:gap-10 lg:gap-14\">\n          <p className=\"max-w-[16rem] text-base font-medium leading-snug text-muted-foreground md:text-lg\">\n            Trusted by the best leading brands:\n          </p>\n          <Marquee brands={brands} />\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/brands-section-v1.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/styles/brands-section-v1.css",
      "content": ".bs1-marquee-wrap {\n  position: relative;\n  overflow: hidden;\n}\n\n/* Track holds two identical sets side-by-side → always 2× one set wide.\n   Animating to -50% is therefore always exactly one set — no JS needed. */\n.bs1-track {\n  display: flex;\n  width: max-content;\n  flex-wrap: nowrap;\n  align-items: center;\n  padding: 0.35rem 0;\n  backface-visibility: hidden;\n  animation: bs1-marquee 28s linear infinite;\n  will-change: transform;\n}\n\n.bs1-set {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 2.5rem;\n  padding-inline: 0.5rem;\n}\n\n@media (min-width: 768px) {\n  .bs1-set {\n    gap: 3.75rem;\n    padding-inline: 0.75rem;\n  }\n}\n\n@media (min-width: 1024px) {\n  .bs1-set {\n    gap: 4rem;\n  }\n}\n\n.bs1-slot {\n  padding-inline: 1rem;\n}\n\n@media (min-width: 768px) {\n  .bs1-slot {\n    padding-inline: 1.5rem;\n  }\n}\n\n.bs1-fade {\n  pointer-events: none;\n  position: absolute;\n  top: 0;\n  z-index: 1;\n  height: 100%;\n  width: 64px;\n}\n\n.bs1-fade-left {\n  left: 0;\n  background: linear-gradient(90deg, var(--background) 0%, transparent 100%);\n}\n\n.bs1-fade-right {\n  right: 0;\n  background: linear-gradient(270deg, var(--background) 0%, transparent 100%);\n}\n\n@keyframes bs1-marquee {\n  from {\n    transform: translate3d(0, 0, 0);\n  }\n  to {\n    transform: translate3d(-50%, 0, 0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .bs1-track {\n    animation-duration: 0.01ms;\n    animation-iteration-count: 1;\n  }\n\n  .bs1-fade {\n    display: none;\n  }\n}\n",
      "type": "registry:file",
      "target": "app/hero-section-v1/styles/brands-section-v1.css"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/mac-os-terminal.tsx",
      "content": "\"use client\"\n\nimport { Folder } from \"lucide-react\"\nimport { cn } from \"@/lib/utils\"\n\nimport { useTerminalAnimation } from \"../hooks/use-terminal-animation\"\nimport Spinner from \"./spinner\"\nimport PromptShell from \"./prompt-shell\"\nimport TrafficLights from \"./traffic-lights\"\nimport SyntaxCode from \"./syntax-code\"\nimport { CODE_DEMO } from \"../lib/mac-os-terminal-code-segments\"\nimport type { LineColor } from \"../lib/terminal-config\"\n\nimport \"../styles/mac-os-terminal.css\"\n\nconst codeBlockWrap = \"mot-codeblock my-2 py-2 pr-2 pl-3 text-[12px] leading-[1.55]\"\n\nfunction colorCls(c?: LineColor) {\n  if (!c) return \"mot-t-line-default\"\n  switch (c) {\n    case \"green\": return \"mot-t-line-green\"\n    case \"cyan\":  return \"mot-t-line-cyan\"\n    case \"dim\":   return \"mot-t-line-dim\"\n  }\n}\n\nexport default function MacOsTerminal() {\n  const { lines, typed, phase, codeIdx, scrollRef } = useTerminalAnimation()\n\n  return (\n    <div className=\"mot-terminal mot-terminal-shell w-full overflow-hidden rounded-md\">\n      <div className=\"mot-terminal-titlebar relative flex h-8 shrink-0 select-none items-center\">\n        <TrafficLights />\n        <div className=\"mot-terminal-title flex w-full items-center justify-center gap-1.5 px-20 text-center font-sans text-[12px] font-medium tracking-tight\">\n          <Folder size={14} className=\"size-3.5 shrink-0\" fill=\"#3b8eea\" stroke=\"none\" strokeWidth={0} aria-hidden />\n          <span>Projects</span>\n          <span className=\"text-[#a1a1aa] dark:text-[#6b6b6b]\" aria-hidden>—</span>\n          <span>-zsh</span>\n          <span className=\"text-[#a1a1aa] dark:text-[#6b6b6b]\" aria-hidden>—</span>\n          <span className=\"tabular-nums\">80×24</span>\n        </div>\n      </div>\n\n      <div\n        ref={scrollRef}\n        className=\"mot-terminal-body max-h-[48rem] min-h-[30rem] overflow-y-auto px-4 py-2.5 text-left font-mono text-[13px] leading-relaxed\"\n        style={{ scrollbarWidth: \"none\" }}\n      >\n        {lines.map((line) => (\n          <div key={line.id} className={cn(\"mot-terminal-line-in\", colorCls(line.color))}>\n            {line.spinning ? (\n              <span><Spinner /> {line.text}</span>\n            ) : (\n              line.text || \"\\u00A0\"\n            )}\n          </div>\n        ))}\n\n        {(phase === \"typingCode\" || phase === \"done\") && (\n          <div className={codeBlockWrap}>\n            <pre className=\"m-0 whitespace-pre-wrap break-words font-mono\">\n              <SyntaxCode visibleChars={phase === \"done\" ? CODE_DEMO.length : codeIdx} />\n              {phase === \"typingCode\" && <span className=\"mot-terminal-cursor\" />}\n            </pre>\n          </div>\n        )}\n\n        {(phase === \"idle\" || phase === \"typing\") && (\n          <div className=\"flex min-w-0 flex-wrap items-center gap-x-1 gap-y-0\">\n            <PromptShell />\n            <span className=\"min-w-0\">{typed}</span>\n            <span className=\"mot-terminal-cursor\" />\n          </div>\n        )}\n\n        {phase === \"done\" && (\n          <div className=\"mt-2 flex items-center gap-x-1\">\n            <PromptShell />\n            <span className=\"mot-terminal-cursor\" />\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/mac-os-terminal.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/brand-logo.tsx",
      "content": "import type { Brand } from \"../lib/brands\"\n\nexport default function BrandLogo({ brand }: { brand: Brand }) {\n  const Light = brand.light\n  const Dark = brand.dark\n\n  if (Dark) {\n    return (\n      <span className=\"inline-flex h-7 w-32 items-center justify-center md:h-8 md:w-36\">\n        <Light className=\"bs1-logo-img block h-full w-full dark:hidden\" aria-label={brand.name} />\n        <Dark className=\"bs1-logo-img hidden h-full w-full dark:block\" aria-label={brand.name} />\n      </span>\n    )\n  }\n\n  return (\n    <span className=\"inline-flex h-7 w-32 items-center justify-center md:h-8 md:w-36\">\n      <Light className=\"bs1-logo-img h-full w-full\" aria-label={brand.name} />\n    </span>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/brand-logo.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/prompt-shell.tsx",
      "content": "import type { ReactNode } from \"react\"\nimport { PROMPT } from \"../lib/terminal-config\"\n\nexport default function PromptShell({ children }: { children?: ReactNode }) {\n  return (\n    <div className=\"flex min-w-0 flex-wrap items-center gap-x-1\">\n      <span className=\"shrink-0 tabular-nums\">{PROMPT}</span>\n      {children}\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/prompt-shell.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/spinner.tsx",
      "content": "\"use client\"\n\nimport { useEffect, useState } from \"react\"\n\nconst FRAMES = [\"⠋\", \"⠙\", \"⠹\", \"⠸\", \"⠼\", \"⠴\", \"⠦\", \"⠧\", \"⠇\", \"⠏\"]\n\nexport default function Spinner() {\n  const [frame, setFrame] = useState(0)\n  useEffect(() => {\n    const t = setInterval(() => setFrame((f) => (f + 1) % FRAMES.length), 80)\n    return () => clearInterval(t)\n  }, [])\n  return <span>{FRAMES[frame]}</span>\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/spinner.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/syntax-code.tsx",
      "content": "import type { ReactNode } from \"react\"\nimport { CODE_SYNTAX_PARTS } from \"../lib/mac-os-terminal-code-segments\"\n\nexport default function SyntaxCode({ visibleChars }: { visibleChars: number }) {\n  let remaining = visibleChars\n  const nodes: ReactNode[] = []\n  let key = 0\n  for (const { t, c } of CODE_SYNTAX_PARTS) {\n    if (remaining <= 0) break\n    const take = Math.min(t.length, remaining)\n    if (take > 0) {\n      nodes.push(\n        <span key={key++} className={c}>\n          {t.slice(0, take)}\n        </span>,\n      )\n      remaining -= take\n    }\n  }\n  return <>{nodes}</>\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/syntax-code.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/components/traffic-lights.tsx",
      "content": "export default function TrafficLights() {\n  return (\n    <div className=\"absolute left-3 flex gap-2\" aria-hidden>\n      <button type=\"button\" tabIndex={-1} className=\"size-3 shrink-0 rounded-full bg-[#ff5f57] ring-1 ring-black/10\" />\n      <button type=\"button\" tabIndex={-1} className=\"size-3 shrink-0 rounded-full bg-[#febc2e] ring-1 ring-black/10\" />\n      <button type=\"button\" tabIndex={-1} className=\"size-3 shrink-0 rounded-full bg-[#28c840] ring-1 ring-black/10\" />\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/hero-section-v1/components/traffic-lights.tsx"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/hooks/use-terminal-animation.ts",
      "content": "// Phase flow: idle → typing → output → typingCode → done → idle (loops)\nimport { useEffect, useRef, useState } from \"react\"\n\nimport {\n  COMMAND, INIT_LINES, OUTPUT_SEQUENCE, PROMPT,\n  TYPE_CODE_MS, TYPE_CODE_NEWLINE_MS, TYPE_SPEED,\n  type Line, type Phase,\n} from \"../lib/terminal-config\"\nimport { CODE_DEMO } from \"../lib/mac-os-terminal-code-segments\"\n\nexport function useTerminalAnimation() {\n  const [lines, setLines] = useState<Line[]>(INIT_LINES)\n  const [typed, setTyped] = useState(\"\")\n  const [phase, setPhase] = useState<Phase>(\"idle\")\n  const [outIdx, setOutIdx] = useState(0)\n  const [codeIdx, setCodeIdx] = useState(0)\n  const idRef = useRef(10)\n  const spinTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n  const scrollRef = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    if (scrollRef.current) {\n      scrollRef.current.scrollTop = scrollRef.current.scrollHeight\n    }\n  }, [lines, typed, codeIdx, phase])\n\n  useEffect(() => {\n    if (phase !== \"idle\") return\n    const t = setTimeout(() => setPhase(\"typing\"), 1600)\n    return () => clearTimeout(t)\n  }, [phase])\n\n  useEffect(() => {\n    if (phase !== \"typing\") return\n    if (typed.length < COMMAND.length) {\n      const t = setTimeout(() => setTyped(COMMAND.slice(0, typed.length + 1)), TYPE_SPEED)\n      return () => clearTimeout(t)\n    }\n    const t = setTimeout(() => {\n      setLines((prev) => [...prev, { id: idRef.current++, text: `${PROMPT}${COMMAND}` }])\n      setTyped(\"\")\n      setOutIdx(0)\n      setPhase(\"output\")\n    }, 360)\n    return () => clearTimeout(t)\n  }, [phase, typed])\n\n  useEffect(() => {\n    if (phase !== \"output\") return\n    if (outIdx >= OUTPUT_SEQUENCE.length) {\n      const t = setTimeout(() => { setCodeIdx(0); setPhase(\"typingCode\") }, 450)\n      return () => clearTimeout(t)\n    }\n    const item = OUTPUT_SEQUENCE[outIdx]\n    if (item.type === \"spinner\") {\n      const t = setTimeout(() => {\n        const spinId = idRef.current++\n        setLines((prev) => [...prev, { id: spinId, text: item.text, spinning: true }])\n        spinTimerRef.current = setTimeout(() => {\n          setLines((prev) =>\n            prev.map((l) =>\n              l.id === spinId\n                ? { ...l, spinning: false, text: `✓ ${item.doneText}`, color: \"green\" as const }\n                : l,\n            ),\n          )\n          setOutIdx((i) => i + 1)\n        }, item.duration)\n      }, item.delay)\n      return () => {\n        clearTimeout(t)\n        if (spinTimerRef.current) clearTimeout(spinTimerRef.current)\n      }\n    }\n    const t = setTimeout(() => {\n      setLines((prev) => [...prev, { id: idRef.current++, text: item.text, color: item.color }])\n      setOutIdx((i) => i + 1)\n    }, item.delay)\n    return () => clearTimeout(t)\n  }, [phase, outIdx])\n\n  useEffect(() => {\n    if (phase !== \"typingCode\") return\n    if (codeIdx >= CODE_DEMO.length) {\n      const t = setTimeout(() => setPhase(\"done\"), 320)\n      return () => clearTimeout(t)\n    }\n    const ch = CODE_DEMO[codeIdx]\n    const delay = ch === \"\\n\" ? TYPE_CODE_NEWLINE_MS : TYPE_CODE_MS\n    const t = setTimeout(() => setCodeIdx((i) => i + 1), delay)\n    return () => clearTimeout(t)\n  }, [phase, codeIdx])\n\n  useEffect(() => {\n    if (phase !== \"done\") return\n    const t = setTimeout(() => {\n      idRef.current = 10\n      setTyped(\"\")\n      setOutIdx(0)\n      setCodeIdx(0)\n      setLines(INIT_LINES)\n      setPhase(\"idle\")\n    }, 8000)\n    return () => clearTimeout(t)\n  }, [phase])\n\n  return { lines, typed, phase, codeIdx, scrollRef }\n}\n",
      "type": "registry:hook",
      "target": "app/hero-section-v1/hooks/use-terminal-animation.ts"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/lib/brands.ts",
      "content": "import type { ComponentType, SVGProps } from \"react\"\n\nimport { NvidiaWordmarkLight } from \"@/components/ui/svgs/nvidiaWordmarkLight\"\nimport { NvidiaWordmarkDark } from \"@/components/ui/svgs/nvidiaWordmarkDark\"\nimport { OpenaiWordmarkLight } from \"@/components/ui/svgs/openaiWordmarkLight\"\nimport { OpenaiWordmarkDark } from \"@/components/ui/svgs/openaiWordmarkDark\"\nimport { GrokWordmarkLight } from \"@/components/ui/svgs/grokWordmarkLight\"\nimport { GrokWordmarkDark } from \"@/components/ui/svgs/grokWordmarkDark\"\nimport { PerplexityWordmarkLight } from \"@/components/ui/svgs/perplexityWordmarkLight\"\nimport { PerplexityWordmarkDark } from \"@/components/ui/svgs/perplexityWordmarkDark\"\nimport { ClaudeAiWordmarkIconLight } from \"@/components/ui/svgs/claudeAiWordmarkIconLight\"\nimport { ClaudeAiWordmarkIconDark } from \"@/components/ui/svgs/claudeAiWordmarkIconDark\"\nimport { GoogleWordmark } from \"@/components/ui/svgs/googleWordmark\"\n\nexport type SvgComponent = ComponentType<SVGProps<SVGSVGElement>>\n\nexport type Brand = {\n  name: string\n  light: SvgComponent\n  dark?: SvgComponent\n}\n\nexport const brands: Brand[] = [\n  { name: \"Nvidia\",        light: NvidiaWordmarkLight,       dark: NvidiaWordmarkDark },\n  { name: \"OpenAI\",        light: OpenaiWordmarkLight,       dark: OpenaiWordmarkDark },\n  { name: \"Grok\",          light: GrokWordmarkLight,         dark: GrokWordmarkDark },\n  { name: \"Perplexity AI\", light: PerplexityWordmarkLight,   dark: PerplexityWordmarkDark },\n  { name: \"Claude AI\",     light: ClaudeAiWordmarkIconLight, dark: ClaudeAiWordmarkIconDark },\n  { name: \"Google\",        light: GoogleWordmark },\n]\n",
      "type": "registry:lib",
      "target": "app/hero-section-v1/lib/brands.ts"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/lib/terminal-config.ts",
      "content": "export type LineColor = \"green\" | \"cyan\" | \"dim\"\n\nexport type Phase = \"idle\" | \"typing\" | \"output\" | \"typingCode\" | \"done\"\n\nexport interface Line {\n  id: number\n  text: string\n  color?: LineColor\n  spinning?: boolean\n}\n\nexport type OutputItem =\n  | { type: \"line\"; text: string; color?: LineColor; delay: number }\n  | { type: \"spinner\"; text: string; doneText: string; delay: number; duration: number }\n\nexport const PROMPT = \"user@macbook app % \"\nexport const COMMAND = \"pnpm i ai\"\nexport const TYPE_SPEED = 38\nexport const TYPE_CODE_MS = 11\nexport const TYPE_CODE_NEWLINE_MS = 48\n\nexport const INIT_LINES: Line[] = []\n\nexport const OUTPUT_SEQUENCE: OutputItem[] = [\n  {\n    type: \"spinner\",\n    text: \"Resolving dependencies…\",\n    doneText: \"Resolved dependencies\",\n    delay: 240,\n    duration: 900,\n  },\n  {\n    type: \"spinner\",\n    text: \"Downloading + installing ai…\",\n    doneText: \"Downloaded and installed ai\",\n    delay: 140,\n    duration: 1400,\n  },\n]\n",
      "type": "registry:lib",
      "target": "app/hero-section-v1/lib/terminal-config.ts"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/lib/mac-os-terminal-code-segments.ts",
      "content": "/** Token spans for AI SDK demo — joined string must match CODE_DEMO in mac-os-terminal.tsx */\r\n\r\nexport type MotShClass =\r\n  | \"mot-sh-kw\"\r\n  | \"mot-sh-str\"\r\n  | \"mot-sh-fn\"\r\n  | \"mot-sh-num\"\r\n  | \"mot-sh-prop\"\r\n  | \"mot-sh-var\"\r\n  | \"mot-sh-punct\"\r\n\r\nexport const CODE_SYNTAX_PARTS: ReadonlyArray<{ t: string; c: MotShClass }> = [\r\n  { t: \"import \", c: \"mot-sh-kw\" },\r\n  { t: \"{ \", c: \"mot-sh-punct\" },\r\n  { t: \"generateText\", c: \"mot-sh-fn\" },\r\n  { t: \", \", c: \"mot-sh-punct\" },\r\n  { t: \"tool\", c: \"mot-sh-fn\" },\r\n  { t: \" } \", c: \"mot-sh-punct\" },\r\n  { t: \"from \", c: \"mot-sh-kw\" },\r\n  { t: \"'ai'\", c: \"mot-sh-str\" },\r\n  { t: \";\\n\", c: \"mot-sh-punct\" },\r\n  { t: \"import \", c: \"mot-sh-kw\" },\r\n  { t: \"{ \", c: \"mot-sh-punct\" },\r\n  { t: \"z\", c: \"mot-sh-fn\" },\r\n  { t: \" } \", c: \"mot-sh-punct\" },\r\n  { t: \"from \", c: \"mot-sh-kw\" },\r\n  { t: \"'zod'\", c: \"mot-sh-str\" },\r\n  { t: \";\\n\\n\", c: \"mot-sh-punct\" },\r\n  { t: \"const\", c: \"mot-sh-kw\" },\r\n  { t: \" { \", c: \"mot-sh-punct\" },\r\n  { t: \"text\", c: \"mot-sh-var\" },\r\n  { t: \" } \", c: \"mot-sh-punct\" },\r\n  { t: \"= \", c: \"mot-sh-punct\" },\r\n  { t: \"await\", c: \"mot-sh-kw\" },\r\n  { t: \" \", c: \"mot-sh-punct\" },\r\n  { t: \"generateText\", c: \"mot-sh-fn\" },\r\n  { t: \"({\\n  \", c: \"mot-sh-punct\" },\r\n  { t: \"model\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"'openai/gpt-5.2'\", c: \"mot-sh-str\" },\r\n  { t: \",\\n  \", c: \"mot-sh-punct\" },\r\n  { t: \"prompt\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"'What is the weather like today in San Francisco?'\", c: \"mot-sh-str\" },\r\n  { t: \",\\n  \", c: \"mot-sh-punct\" },\r\n  { t: \"tools\", c: \"mot-sh-prop\" },\r\n  { t: \": {\\n    \", c: \"mot-sh-punct\" },\r\n  { t: \"getWeather\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"tool\", c: \"mot-sh-fn\" },\r\n  { t: \"({\\n      \", c: \"mot-sh-punct\" },\r\n  { t: \"description\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"'Get the weather in a location'\", c: \"mot-sh-str\" },\r\n  { t: \",\\n      \", c: \"mot-sh-punct\" },\r\n  { t: \"inputSchema\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"z\", c: \"mot-sh-fn\" },\r\n  { t: \".\", c: \"mot-sh-punct\" },\r\n  { t: \"object\", c: \"mot-sh-fn\" },\r\n  { t: \"({\\n        \", c: \"mot-sh-punct\" },\r\n  { t: \"location\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"z\", c: \"mot-sh-fn\" },\r\n  { t: \".\", c: \"mot-sh-punct\" },\r\n  { t: \"string\", c: \"mot-sh-fn\" },\r\n  { t: \"()\", c: \"mot-sh-punct\" },\r\n  { t: \".\", c: \"mot-sh-punct\" },\r\n  { t: \"describe\", c: \"mot-sh-fn\" },\r\n  { t: \"(\", c: \"mot-sh-punct\" },\r\n  { t: \"'The location to get the weather for'\", c: \"mot-sh-str\" },\r\n  { t: \")\", c: \"mot-sh-punct\" },\r\n  { t: \",\\n      }),\\n      \", c: \"mot-sh-punct\" },\r\n  { t: \"execute\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"async\", c: \"mot-sh-kw\" },\r\n  { t: \" \", c: \"mot-sh-punct\" },\r\n  { t: \"({ \", c: \"mot-sh-punct\" },\r\n  { t: \"location\", c: \"mot-sh-var\" },\r\n  { t: \" }) => ({\\n        \", c: \"mot-sh-punct\" },\r\n  { t: \"location\", c: \"mot-sh-prop\" },\r\n  { t: \",\\n        \", c: \"mot-sh-punct\" },\r\n  { t: \"temperature\", c: \"mot-sh-prop\" },\r\n  { t: \": \", c: \"mot-sh-punct\" },\r\n  { t: \"72\", c: \"mot-sh-num\" },\r\n  { t: \" + \", c: \"mot-sh-punct\" },\r\n  { t: \"Math\", c: \"mot-sh-fn\" },\r\n  { t: \".\", c: \"mot-sh-punct\" },\r\n  { t: \"floor\", c: \"mot-sh-fn\" },\r\n  { t: \"(\", c: \"mot-sh-punct\" },\r\n  { t: \"Math\", c: \"mot-sh-fn\" },\r\n  { t: \".\", c: \"mot-sh-punct\" },\r\n  { t: \"random\", c: \"mot-sh-fn\" },\r\n  { t: \"() * \", c: \"mot-sh-punct\" },\r\n  { t: \"21\", c: \"mot-sh-num\" },\r\n  { t: \") - \", c: \"mot-sh-punct\" },\r\n  { t: \"10\", c: \"mot-sh-num\" },\r\n  { t: \",\\n      }),\\n    }),\\n  },\\n});\", c: \"mot-sh-punct\" },\r\n]\r\n\r\nexport const CODE_DEMO = CODE_SYNTAX_PARTS.map((p) => p.t).join(\"\")\r\n",
      "type": "registry:lib",
      "target": "app/hero-section-v1/lib/mac-os-terminal-code-segments.ts"
    },
    {
      "path": "registry/new-york/blocks/hero-section-v1/styles/mac-os-terminal.css",
      "content": "/* mac-os-terminal — scoped so consumers need not import app globals */\r\n\r\n\r\n.mot-terminal {\r\n  --mot-t-shell-bg: #fafafa;\r\n  --mot-t-body-bg: #ffffff;\r\n  --mot-t-body-fg: #3f3f46;\r\n  --mot-t-border: rgb(0 0 0 / 0.1);\r\n  --mot-t-ring: rgb(0 0 0 / 0.06);\r\n  --mot-t-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.12);\r\n  --mot-t-titlebar-bg: #ececec;\r\n  --mot-t-titlebar-border: rgb(0 0 0 / 0.08);\r\n  --mot-t-title-fg: #3c3c3c;\r\n  --mot-t-line-green: #15803d;\r\n  --mot-t-line-cyan: #0f766e;\r\n  --mot-t-line-dim: #71717a;\r\n  --mot-terminal-cursor-bg: #27272a;\r\n}\r\n\r\n.dark .mot-terminal {\r\n  --mot-t-shell-bg: #1e1e1e;\r\n  --mot-t-body-bg: #1e1e1e;\r\n  --mot-t-body-fg: #cccccc;\r\n  --mot-t-border: rgb(255 255 255 / 0.1);\r\n  --mot-t-ring: rgb(0 0 0 / 0.2);\r\n  --mot-t-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.45);\r\n  --mot-t-titlebar-bg: #2d2d2d;\r\n  --mot-t-titlebar-border: rgb(255 255 255 / 0.08);\r\n  --mot-t-title-fg: #d4d4d8;\r\n  --mot-t-line-green: #16c60c;\r\n  --mot-t-line-cyan: #61d6d6;\r\n  --mot-t-line-dim: #767676;\r\n  --mot-terminal-cursor-bg: #cccccc;\r\n}\r\n\r\n.mot-terminal-shell {\r\n  border: 1px solid var(--mot-t-border);\r\n  background-color: var(--mot-t-shell-bg);\r\n  box-shadow: var(--mot-t-shadow);\r\n  outline: 1px solid var(--mot-t-ring);\r\n  outline-offset: -1px;\r\n}\r\n\r\n.mot-terminal-titlebar {\r\n  border-bottom: 1px solid var(--mot-t-titlebar-border);\r\n  background-color: var(--mot-t-titlebar-bg);\r\n}\r\n\r\n.mot-terminal-title {\r\n  color: var(--mot-t-title-fg);\r\n}\r\n\r\n.mot-terminal-body {\r\n  background-color: var(--mot-t-body-bg);\r\n  color: var(--mot-t-body-fg);\r\n}\r\n\r\n.mot-t-line-default {\r\n  color: var(--mot-t-body-fg);\r\n}\r\n\r\n.mot-t-line-green {\r\n  color: var(--mot-t-line-green);\r\n}\r\n\r\n.mot-t-line-cyan {\r\n  color: var(--mot-t-line-cyan);\r\n}\r\n\r\n.mot-t-line-dim {\r\n  color: var(--mot-t-line-dim);\r\n}\r\n\r\n.mot-terminal-cursor {\r\n  display: inline-block;\r\n  width: 8px;\r\n  height: 1em;\r\n  margin-left: 1px;\r\n  vertical-align: text-bottom;\r\n  background-color: var(--mot-terminal-cursor-bg);\r\n  animation: mot-terminal-blink 1.15s step-start infinite;\r\n}\r\n\r\n@keyframes mot-terminal-blink {\r\n  0%,\r\n  49.9% {\r\n    opacity: 1;\r\n  }\r\n  50%,\r\n  100% {\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n.mot-terminal-line-in {\r\n  animation: mot-terminal-line-fade 0.12s ease-out both;\r\n}\r\n\r\n@keyframes mot-terminal-line-fade {\r\n  from {\r\n    opacity: 0;\r\n  }\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n.mot-terminal-body::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n/* Syntax highlight panel — token colors swap via CSS vars on .dark */\r\n\r\n.mot-codeblock {\r\n  --mot-sh-kw: #b83280;\r\n  --mot-sh-str: #166534;\r\n  --mot-sh-fn: #6d28d9;\r\n  --mot-sh-num: #0369a1;\r\n  --mot-sh-prop: #18181b;\r\n  --mot-sh-var: #0e7490;\r\n  --mot-sh-punct: #a21caf;\r\n  --mot-cursor-fg: #27272a;\r\n\r\n  border-left-width: 2px;\r\n  border-left-style: solid;\r\n  border-left-color: rgb(59 142 234 / 0.55);\r\n  background-color: rgb(244 244 245 / 0.95);\r\n}\r\n\r\n.dark .mot-codeblock {\r\n  --mot-sh-kw: #ff79c6;\r\n  --mot-sh-str: #50fa7b;\r\n  --mot-sh-fn: #bd93f9;\r\n  --mot-sh-num: #8be9fd;\r\n  --mot-sh-prop: #f8f8f2;\r\n  --mot-sh-var: #8be9fd;\r\n  --mot-sh-punct: #ff79c6;\r\n  --mot-cursor-fg: #cccccc;\r\n\r\n  border-left-color: rgb(59 142 234 / 0.45);\r\n  background-color: rgb(0 0 0 / 0.55);\r\n}\r\n\r\n.mot-sh-kw {\r\n  color: var(--mot-sh-kw);\r\n}\r\n.mot-sh-str {\r\n  color: var(--mot-sh-str);\r\n}\r\n.mot-sh-fn {\r\n  color: var(--mot-sh-fn);\r\n}\r\n.mot-sh-num {\r\n  color: var(--mot-sh-num);\r\n}\r\n.mot-sh-prop {\r\n  color: var(--mot-sh-prop);\r\n}\r\n.mot-sh-var {\r\n  color: var(--mot-sh-var);\r\n}\r\n.mot-sh-punct {\r\n  color: var(--mot-sh-punct);\r\n}\r\n\r\n.mot-codeblock .mot-terminal-cursor {\r\n  background-color: var(--mot-cursor-fg);\r\n}\r\n",
      "type": "registry:file",
      "target": "app/hero-section-v1/styles/mac-os-terminal.css"
    },
