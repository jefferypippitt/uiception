 For Free\r\n                  <ArrowUpRightIcon data-icon=\"inline-end\" />\r\n                </Button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"relative mt-6 aspect-16/5 w-full overflow-hidden\">\r\n            <Image\r\n              src={CTA_IMAGE}\r\n              unoptimized\r\n              alt=\"\"\r\n              aria-hidden\r\n              fill\r\n              className=\"object-cover object-top\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n",
