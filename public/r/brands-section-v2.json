    {
      "path": "registry/new-york/blocks/brands-section-v2/styles/brands-section-v2.css",
      "content": ".bs2-marquee-wrap {\n  position: relative;\n  overflow: hidden;\n  border: 1px solid var(--border);\n}\n\n/* Track holds two identical sets side-by-side → always 2× one set wide.\n   Animating to -50% is therefore always exactly one set — no JS needed. */\n.bs2-track {\n  display: flex;\n  width: max-content;\n  flex-wrap: nowrap;\n  align-items: stretch;\n  backface-visibility: hidden;\n  animation: bs2-marquee 40s linear infinite;\n  will-change: transform;\n}\n\n.bs2-set {\n  display: flex;\n  flex-shrink: 0;\n  align-items: stretch;\n}\n\n.bs2-slot {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 8rem;\n  padding: 0.75rem 0;\n  border-right: 1px solid var(--border);\n}\n\n@media (min-width: 768px) {\n  .bs2-slot {\n    width: 10rem;\n    padding: 1rem 0;\n  }\n}\n\n.bs2-fade {\n  pointer-events: none;\n  position: absolute;\n  top: 0;\n  z-index: 1;\n  height: 100%;\n  width: 140px;\n}\n\n.bs2-fade-left {\n  left: 0;\n  background: linear-gradient(90deg, var(--background) 0%, transparent 100%);\n}\n\n.bs2-fade-right {\n  right: 0;\n  background: linear-gradient(270deg, var(--background) 0%, transparent 100%);\n}\n\n@keyframes bs2-marquee {\n  from {\n    transform: translate3d(0, 0, 0);\n  }\n  to {\n    transform: translate3d(-50%, 0, 0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .bs2-track {\n    animation-duration: 0.01ms;\n    animation-iteration-count: 1;\n  }\n\n  .bs2-fade {\n    display: none;\n  }\n}\n",
      "type": "registry:file",
      "target": "app/brands-section-v2/styles/brands-section-v2.css"
    },
