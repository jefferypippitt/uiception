{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "feature-section-v4",
  "title": "Feature Section v4",
  "description": "Industrial-style three-card feature grid with uppercase heading, blank top card placeholders, and compact data-first copy.",
  "dependencies": [
    "geist@^1.7.0"
  ],
  "registryDependencies": [
    "badge",
    "card"
  ],
  "files": [
    {
      "path": "registry/new-york/blocks/feature-section-v4/page.tsx",
      "content": "import FeatureSectionV4 from \"./feature-section-v4\"\n\nexport default function Page() {\n  return <FeatureSectionV4 />\n}\n",
      "type": "registry:page",
      "target": "app/feature-section-v4/page.tsx"
    },
    {
      "path": "registry/new-york/blocks/feature-section-v4/feature-section-v4.tsx",
      "content": "import FeatureGrid from \"./feature-grid\"\n\nconst featureImage = (filename: string) =>\n  `/images/blocks/feature-section-v4/${filename}`\n\nexport default function FeatureSectionV4() {\n  const featureImageById = {\n    \"cognitive-ai\": featureImage(\"feature-section-v4-brain.png\"),\n    \"global-reach\": featureImage(\"feature-section-v4-planet.png\"),\n    \"limitless-growth\": featureImage(\"feature-section-v4-hand.png\"),\n  } as const\n\n  return (\n    <section className=\"py-16 md:py-20 lg:py-24\">\n      <div className=\"mx-auto max-w-6xl px-4 sm:px-6 lg:px-8\">\n        <div className=\"mb-9 grid gap-3 lg:mb-11 lg:grid-cols-[minmax(0,1fr)_minmax(0,380px)] lg:items-end lg:gap-10\">\n          <h2 className=\"max-w-[16ch] text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.06] font-medium tracking-[-0.02em] uppercase\">\n            Built for What&apos;s Possible\n          </h2>\n          <p className=\"max-w-[42ch] text-3.75 leading-[1.72] font-normal text-muted-foreground lg:pb-1\">\n            When you are building what comes next, you need tools that learn\n            from real use, work across regions, and grow with every goal you\n            add.\n          </p>\n        </div>\n        <FeatureGrid imageById={featureImageById} />\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/feature-section-v4/feature-section-v4.tsx"
    },
    {
      "path": "registry/new-york/blocks/feature-section-v4/feature-grid.tsx",
      "content": "import Image from \"next/image\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\"\nimport { featureSectionItems } from \"./features\"\nimport \"./feature-grid.css\"\n\ntype FeatureId = (typeof featureSectionItems)[number][\"id\"]\n\ntype FeatureGridProps = {\n  imageById: Record<FeatureId, string>\n}\n\nexport default function FeatureGrid({ imageById }: FeatureGridProps) {\n  return (\n    <ul className=\"m-0 grid list-none grid-cols-1 gap-3 p-0 sm:gap-3.4 lg:grid-cols-3 lg:gap-3.6\">\n      {featureSectionItems.map(\n        ({ id, labelPrimary, labelSecondary, title, points }) => (\n          <li key={id} className=\"min-w-0\">\n            <Card className=\"relative flex h-full min-h-68 w-full flex-col gap-0 p-0 sm:min-h-80 lg:min-h-88\">\n\n              <Image\n                alt=\"\"\n                aria-hidden={true}\n                className=\"z-0 object-cover object-center grayscale\"\n                fill\n                loading=\"lazy\"\n                sizes=\"(max-width: 1023px) 100vw, 33vw\"\n                src={imageById[id]}\n              />\n              <div className=\"pointer-events-none absolute inset-0 z-10 bg-linear-to-t from-black via-black/80 to-black/10\" />\n              <div className=\"relative z-20 mt-auto flex flex-col\">\n                <CardHeader className=\"grid gap-2 rounded-none bg-transparent px-2.88 pt-2! pb-3! sm:px-4 sm:pt-2.5! sm:pb-3.5!\">\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    <Badge className=\"h-auto rounded-md border border-[#cfcfcf] bg-[#f3f3f3] py-0.5 text-2.72 leading-none font-semibold tracking-[0.03em] text-[#111] uppercase hover:bg-[#e8e8e8] dark:hover:bg-[#e8e8e8]\">\n                      {labelPrimary}\n                    </Badge>\n                    <Badge className=\"h-auto rounded-md border border-[#cfcfcf] bg-[#f3f3f3] py-0.5 text-2.72 leading-none font-semibold tracking-[0.03em] text-[#111] uppercase hover:bg-[#e8e8e8] dark:hover:bg-[#e8e8e8]\">\n                      {labelSecondary}\n                    </Badge>\n                  </div>\n                  <CardTitle className=\"m-0 min-h-[calc(1.03rem*1.28*2)] font-mono text-4.12 leading-[1.28] font-semibold tracking-[-0.015em] text-[#efefef] uppercase\">\n                    {title}\n                  </CardTitle>\n                </CardHeader>\n                <CardContent className=\"px-2.88 pt-0 pb-4 sm:px-4\">\n                  <ul className=\"fsv4-points m-0 grid list-none gap-0.88 p-0 font-mono text-2.92 leading-normal tracking-[0.025em] text-[#c8cccc] uppercase\">\n                    {points.map((point) => (\n                      <li key={point}>{point}</li>\n                    ))}\n                  </ul>\n                </CardContent>\n              </div>\n            </Card>\n          </li>\n        )\n      )}\n    </ul>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/feature-section-v4/feature-grid.tsx"
    },
    {
      "path": "registry/new-york/blocks/feature-section-v4/feature-grid.css",
      "content": "\n\n.fsv4-points li {\n  position: relative;\n  padding-left: 0.92rem;\n}\n\n.fsv4-points li::before {\n  content: \"✶\";\n  position: absolute;\n  left: 0;\n  top: 0;\n  color: #cfd3d3;\n}\n",
      "type": "registry:file",
      "target": "app/feature-section-v4/feature-grid.css"
    },
    {
      "path": "registry/new-york/blocks/feature-section-v4/features.ts",
      "content": "export type FeatureDefinition = {\n  id: \"cognitive-ai\" | \"global-reach\" | \"limitless-growth\"\n  labelPrimary: string\n  labelSecondary: string\n  title: string\n  points: [string, string]\n}\n\nexport const featureSectionItems: FeatureDefinition[] = [\n  {\n    id: \"cognitive-ai\",\n    labelPrimary: \"AI\",\n    labelSecondary: \"Intelligence\",\n    title: \"Cognitive AI Engine\",\n    points: [\"Learns from every interaction\", \"Surfaces insights instantly\"],\n  },\n  {\n    id: \"global-reach\",\n    labelPrimary: \"Global\",\n    labelSecondary: \"Scale\",\n    title: \"Planetary-Scale Reach\",\n    points: [\"Deploys across every region\", \"Connects teams worldwide\"],\n  },\n  {\n    id: \"limitless-growth\",\n    labelPrimary: \"Growth\",\n    labelSecondary: \"Ambition\",\n    title: \"Reach Beyond Limits\",\n    points: [\"Built for what's next\", \"Grows with your vision\"],\n  },\n]\n",
      "type": "registry:lib",
      "target": "app/feature-section-v4/features.ts"
    },
    {
