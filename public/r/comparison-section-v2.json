{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "comparison-section-v2",
  "title": "Comparison Section v2",
  "description": "DoorDash, Uber, and Instacart compared with horizontal bars for 2025 revenue and order value. Uber is its Delivery segment. No table and no card.",
  "dependencies": [
    "geist"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/new-york/blocks/comparison-section-v2/page.tsx",
      "content": "import ComparisonSectionV2 from \"./components/comparison-section-v2\"\r\n\r\nexport default function Page() {\r\n  return <ComparisonSectionV2 />\r\n}\r\n",
      "type": "registry:page",
      "target": "app/comparison-section-v2/page.tsx"
    },
    {
      "path": "registry/new-york/blocks/comparison-section-v2/components/comparison-section-v2.tsx",
      "content": "import { GeistSans } from \"geist/font/sans\"\n\nimport ComparisonChartList from \"./comparison-chart\"\nimport { comparisonHeader } from \"../lib/comparison\"\n\nexport default function ComparisonSectionV2() {\n  return (\n    <section className={`py-16 font-sans md:py-24 ${GeistSans.className}`}>\n      <div className=\"mx-auto max-w-6xl px-6\">\n        <header className=\"max-w-2xl\">\n          <h2 className=\"text-4xl font-medium leading-[1.1] tracking-[-0.03em] text-balance text-foreground md:text-5xl\">\n            {comparisonHeader.title}\n          </h2>\n        </header>\n        <ComparisonChartList />\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "app/comparison-section-v2/components/comparison-section-v2.tsx"
    },
    {
      "path": "registry/new-york/blocks/comparison-section-v2/components/comparison-chart.tsx",
      "content": "import {\r\n  charts,\r\n  companies,\r\n  type Company,\r\n  type ComparisonBar,\r\n  type ComparisonChart,\r\n} from \"../lib/comparison\"\r\n\r\nconst companyById = new Map(companies.map((company) => [company.id, company]))\r\n\r\nexport default function ComparisonChartList() {\r\n  return (\r\n    <div className=\"mt-12 flex max-w-3xl flex-col gap-14 md:mt-16\">\r\n      {charts.map((chart) => (\r\n        <Chart key={chart.id} chart={chart} />\r\n      ))}\r\n    </div>\r\n  )\r\n}\r\n\r\nfunction Chart({ chart }: { chart: ComparisonChart }) {\r\n  return (\r\n    <section aria-label={chart.label}>\r\n      <h3 className=\"text-xs text-muted-foreground\">{chart.label}</h3>\r\n      <ul className=\"mt-2\">\r\n        {chart.bars.map((bar) => {\r\n          const company = companyById.get(bar.companyId)\r\n          if (!company) return null\r\n          return <BarRow key={bar.companyId} company={company} bar={bar} />\r\n        })}\r\n      </ul>\r\n    </section>\r\n  )\r\n}\r\n\r\nfunction BarRow({ company, bar }: { company: Company; bar: ComparisonBar }) {\r\n  return (\r\n    <li className=\"border-b border-border py-4\">\r\n      <div className=\"flex items-center justify-between gap-4\">\r\n        <span className=\"flex min-w-0 items-center gap-2.5\">\r\n          <CompanyLogo company={company} />\r\n          {company.wordmark ? (\r\n            <span className=\"sr-only\">{company.name}</span>\r\n          ) : (\r\n            <span className=\"text-sm font-medium text-foreground\">{company.name}</span>\r\n          )}\r\n          {company.note ? (\r\n            <span className=\"text-sm text-muted-foreground\">{company.note}</span>\r\n          ) : null}\r\n        </span>\r\n        <span className=\"shrink-0 text-sm text-foreground tabular-nums\">{bar.value}</span>\r\n      </div>\r\n      <div aria-hidden className=\"mt-3 h-2 rounded-full bg-muted\">\r\n        <div className={`h-full rounded-full bg-foreground ${bar.widthClass}`} />\r\n      </div>\r\n    </li>\r\n  )\r\n}\r\n\r\nfunction CompanyLogo({ company }: { company: Company }) {\r\n  const Light = company.logoLight\r\n  const Dark = company.logoDark\r\n\r\n  return (\r\n    <span aria-hidden className=\"inline-flex h-6 shrink-0 items-center\">\r\n      <Light\r\n        aria-hidden\r\n        className={\r\n          Dark ? `${company.logoClassName} dark:hidden` : company.logoClassName\r\n        }\r\n      />\r\n      {Dark ? (\r\n        <Dark aria-hidden className={`${company.logoClassName} hidden dark:block`} />\r\n      ) : null}\r\n    </span>\r\n  )\r\n}\r\n",
      "type": "registry:component",
      "target": "app/comparison-section-v2/components/comparison-chart.tsx"
    },
