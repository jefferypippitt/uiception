{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hero-section-v6",
  "title": "Hero Section v6",
  "description": "Centered hero with headline, description, two CTA buttons, a product screenshot, and a brands marquee strip below.",
  "dependencies": [
    "gsap",
    "@paper-design/shaders-react"
  ],
