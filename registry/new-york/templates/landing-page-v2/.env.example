# Landing Page v2 needs no env vars to run — the register flow (lib/actions.ts)
# validates every field and returns success without persisting anything.
#
# When you wire up your own backend, this is the conventional place for its URL.
# Referenced in the commented example inside registerAction():
#   await fetch(process.env.REGISTER_ENDPOINT!, { method: "POST", ... })
# Swap in whatever your persistence / email / CRM call actually needs.
REGISTER_ENDPOINT=
