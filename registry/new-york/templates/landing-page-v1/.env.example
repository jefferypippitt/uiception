# Clerk keys — run `npx clerk init -y` to fill these automatically (https://clerk.com/docs/cli),
# or grab both from https://dashboard.clerk.com/~/api-keys
# Then enable Waitlist mode: Clerk Dashboard → Waitlist → toggle "Enable waitlist".
# Until these are set, the page renders a local demo form that stores nothing.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# After invite accept / sign-in, send people back to the homepage.
# Change these to /dashboard (or similar) once you add that route.
# Also set the same URLs in Clerk Dashboard → Account Portal → Redirects
# so hosted invite emails don't land on accounts.dev/default-redirect.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Svix signing secret from the webhook endpoint in Clerk Dashboard.
# Local: clerk webhooks listen --forward-to http://localhost:3000/api/webhooks
# → add the printed https://webhooks.clerk.com/in/c_…/ URL as an endpoint
#   (subscribe to waitlistEntry.created / waitlistEntry.updated), then paste
#   that endpoint's whsec_… secret here.
CLERK_WEBHOOK_SIGNING_SECRET=
